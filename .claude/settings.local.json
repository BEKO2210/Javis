{
  "enabledMcpjsonServers": [
    "claude-flow",
    "ruv-swarm",
    "flow-nexus"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workgraph status . 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workgraph watch . --once --source claude --provider local >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(CLAUDE_PROJECT_DIR=/mnt/c/Users/belki/Desktop/Experiment/Javis sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" pre-bash')"
    ]
  }
}
